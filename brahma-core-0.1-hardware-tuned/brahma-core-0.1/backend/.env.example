APP_NAME=BRAHMA CORE
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./brahma.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
BRAHMA_CHAT_MODEL=qwen3:1.7b
BRAHMA_EMBEDDING_MODEL=bge-m3
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=brahma_knowledge_v1
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# Hardware profile: 16 GB RAM / 1 GB VRAM
BRAHMA_NUM_CTX=4096
BRAHMA_NUM_PREDICT=512
