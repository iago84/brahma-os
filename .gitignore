# BRAHMA — .gitignore
# Excluye lo pesado / regenerable / de terceros antes de publicar el repo (CI).

# --- Salidas de build de imagen (grandes, regenerables) ---
*.iso
*.img
*.hybrid.iso
*.xz
*.tar

# --- live-build: productos de trabajo (auto/ y config/hooks/ SÍ se versionan) ---
/brahma-os/iso/live-build/.build/
/brahma-os/iso/live-build/binary/
/brahma-os/iso/live-build/bootstrap/
/brahma-os/iso/live-build/cache/
/brahma-os/iso/live-build/chroot/
/brahma-os/iso/live-build/*.iso
/brahma-os/iso/live-build/*.img
# config/ se genera con `lb config`; solo conservamos nuestros hooks
/brahma-os/iso/live-build/config/*
!/brahma-os/iso/live-build/config/hooks/

# --- Entorno WSL (discos e imágenes enormes; no versionar) ---
/WSL/

# --- Terceros (AGPL aislado; no redistribuir en repo público) — ver docs/DISTRO_PLAN.md §6 ---
/external/

# --- Secretos (nunca versionar; solo *.example) — regla 5 ---
.env
.env.local
.env.*.local

# --- Basura de instalaciones pip mal escritas ---
/=2.0
/=3.1

# --- Python / Node ---
__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
.next/
