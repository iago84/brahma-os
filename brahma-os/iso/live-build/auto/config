#!/bin/sh
# BRAHMA OS — configuracion de live-build (perfil PC x86_64).
# Ejecutado por build.sh o por `lb build` (paso auto/config).
# Referencia: https://live-team.pages.debian.net/live-manual/
#
# Base: Ubuntu/Kubuntu LTS (coherente con base/packages/desktop-pc.list -> kubuntu-desktop).
#   Requiere host Ubuntu (lab: WSL2 Ubuntu-24.04-F) y el paquete `live-build`.
#   Alternativa Debian: cambia --mode/--distribution/mirrors (ver README.md).
set -e

lb config noauto \
  --mode ubuntu \
  --distribution noble \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --bootloader grub-efi \
  --bootappend-live "boot=live components quiet splash" \
  --archive-areas "main restricted universe multiverse" \
  --apt-recommends false \
  --apt-pipeline 1 \
  --apt-options "--yes --option Acquire::http::Timeout=30 --option Acquire::https::Timeout=30 --option Acquire::Retries=10" \
  --linux-flavours generic \
  --image-name brahma-os \
  --iso-application "BRAHMA OS" \
  --iso-publisher "Naira Studio / BRAHMA" \
  --iso-volume "BRAHMA_OS_LIVE" \
  --mirror-bootstrap "http://archive.ubuntu.com/ubuntu" \
  --mirror-chroot "http://archive.ubuntu.com/ubuntu" \
  --mirror-binary "http://archive.ubuntu.com/ubuntu" \
  "$@"
